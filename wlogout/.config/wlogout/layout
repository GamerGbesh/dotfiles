{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown [S]",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot [R]",
    "keybind" : "r"
}
{
    "label" : "logout",
    "action" : "loginctl kill-session $XDG_SESSION_ID",
    "text" : "Logout [E]",
    "keybind" : "e"
}
{
    "label" : "hibernate",
    "action" : "hyprlock && systemctl hibernate",
    "text" : "Hibernate [H]",
    "keybind" : "h"
}
{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock [L]",
    "keybind" : "l"
}
